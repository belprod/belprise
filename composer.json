{
    "name": "belprod/belprise",
    "description": "belprise — revue vidéo à l’image près, auto-hébergée (belprod)",
    "type": "project",
    "license": "PolyForm-Shield-1.0.0",
    "require": {
        "php": ">=8.2",
        "ext-pdo_sqlite": "*",
        "ext-mbstring": "*",
        "ext-fileinfo": "*",
        "ext-openssl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Belprise\\": "app/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Belprise\\Tests\\": "tests/php/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true
    }
}

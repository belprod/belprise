# belprise.fr — site vitrine (static files only, no PHP). Indexable, unlike the application.
Options -Indexes -MultiViews
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
    Header always set Content-Security-Policy "default-src 'none'; style-src 'self'; font-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    Header always set Referrer-Policy "no-referrer"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=(), browsing-topics=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    # Uncomment once HTTPS is in place:
    # Header always set Strict-Transport-Security "max-age=31536000"

    <If "%{REQUEST_URI} =~ m#^/assets/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    # HTTPS only (cPanel's "Force HTTPS" may not save). Local development stays
    # on http. X-Forwarded-Proto: TLS already ended by the host's front server.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
    # Hidden files (.htaccess…) are never served.
    RewriteRule (^|/)\. - [R=404,L]
</IfModule>

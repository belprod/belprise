# Belprise — Apache configuration. The web root is public/.
# Requires mod_rewrite and mod_headers (Apache 2.4).

Options -Indexes -MultiViews
DirectoryIndex disabled

# ---------------------------------------------------------------------------
# Crawlers, AI agents and link-preview bots: 403.
# Same list as Belprise\Security\BotBlocker (checked again in PHP).
# Apache's own 403s (bots, ".ht*" files) are handed to PHP, which answers 403
# to bots and the neutral 404 to everything else. REDIRECT_STATUS is set only
# on that internal hand-over, so index.php is reachable for it.
# ---------------------------------------------------------------------------
<RequireAll>
    Require all granted
    Require expr "-n %{ENV:REDIRECT_STATUS} || ! %{HTTP_USER_AGENT} =~ /GPTBot|ChatGPT-User|OAI-SearchBot|ClaudeBot|Claude-Web|Claude-User|Claude-SearchBot|anthropic-ai|CCBot|PerplexityBot|Perplexity-User|Bytespider|Meta-ExternalAgent|Meta-ExternalFetcher|Amazonbot|Applebot|Applebot-Extended|Google-Extended|Google-CloudVertexBot|cohere-ai|Diffbot|YouBot|MistralAI-User|DuckAssistBot|AI2Bot|Timpibot|ImagesiftBot|Omgilibot|Googlebot|bingbot|YandexBot|Baiduspider|DuckDuckBot|PetalBot|SemrushBot|AhrefsBot|facebookexternalhit|Twitterbot|Slackbot|LinkedInBot|Discordbot|TelegramBot|WhatsApp/i"
</RequireAll>
ErrorDocument 403 /index.php

# ---------------------------------------------------------------------------
# Headers. PHP sends the same values; "unset" removes PHP's copy so that
# each header appears once. PHP also sends its own CSP (with a nonce).
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header unset X-Robots-Tag
    Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex, noai, noimageai"
    Header unset Referrer-Policy
    Header always set Referrer-Policy "no-referrer"
    Header unset X-Content-Type-Options
    Header always set X-Content-Type-Options "nosniff"
    Header unset X-Frame-Options
    Header always set X-Frame-Options "DENY"
    Header unset Permissions-Policy
    Header always set Permissions-Policy "accelerometer=(), autoplay=(self), browsing-topics=(), camera=(), display-capture=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(self), publickey-credentials-get=(), screen-wake-lock=(), usb=(), xr-spatial-tracking=()"
    Header always set Content-Security-Policy "default-src 'none'; style-src 'self'; font-src 'self'; img-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'" "expr=-z resp('Content-Security-Policy')"

    # Hashed build files never change.
    <If "%{REQUEST_URI} =~ m#^/assets/.+-[A-Za-z0-9_-]{8}\.(js|css|woff2)$#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
</IfModule>

# No request body above 48 MB (upload chunks are 32 MB).
LimitRequestBody 50331648

# ---------------------------------------------------------------------------
# PHP limits when PHP runs as an Apache module (same values as .user.ini,
# which PHP-FPM / CGI hosts read instead).
# ---------------------------------------------------------------------------
<IfModule mod_php.c>
    php_value memory_limit 256M
    php_value post_max_size 48M
    php_value upload_max_filesize 48M
    php_value max_execution_time 300
    php_value max_input_time 300
    php_flag display_errors off
</IfModule>

# ---------------------------------------------------------------------------
# Front controller: everything that is not an existing file goes to PHP.
# Hidden files (assets/.vite/, assets/.hot) get the neutral 404 from PHP.
# ---------------------------------------------------------------------------
ErrorDocument 404 /index.php
<IfModule mod_rewrite.c>
    RewriteEngine On
    # HTTPS only (cPanel's "Force HTTPS" may not save). Local development stays
    # on http. X-Forwarded-Proto: TLS already ended by the host's front server.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
    RewriteRule (^|/)\. index.php [END]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [END]
</IfModule>
